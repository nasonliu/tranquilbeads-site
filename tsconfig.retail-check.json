{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "app/[locale]/shop/**/*.tsx",
    "app/[locale]/privacy/page.tsx",
    "app/[locale]/terms/page.tsx",
    "app/[locale]/shipping-returns/page.tsx",
    "app/admin/retail/**/*.tsx",
