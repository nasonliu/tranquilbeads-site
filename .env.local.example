# Google Ads API credentials
# Copy this file to .env.local on each machine and fill real values locally.
# Never commit real developer tokens, client secrets, or refresh tokens.

GOOGLE_ADS_DEVELOPER_TOKEN="replace-me"
GOOGLE_ADS_CLIENT_ID="replace-me.apps.googleusercontent.com"
GOOGLE_ADS_CLIENT_SECRET="replace-me"
GOOGLE_ADS_REFRESH_TOKEN="replace-me"
GOOGLE_ADS_CUSTOMER_ID="7091121019"

# Keep empty for the current TranquilBeads setup.
# Setting this to 8010459176 caused USER_PERMISSION_DENIED for customer 7091121019.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Only needed when generating a new OAuth refresh token.
GOOGLE_ADS_REDIRECT_URI="http://localhost:18080/oauth2callback"

# Optional site tracking override.
NEXT_PUBLIC_GTM_ID="GTM-M9JCZKFC"

# Password for /admin/inquiries. Set a strong value in Vercel, do not commit the real password.
ADMIN_INQUIRIES_PASSWORD=""

# Direct retail checkout (disabled unless exactly "true"). Set only in Vercel.
RETAIL_SHOP_ENABLED="false"
# Required whenever checkout is enabled. Preview and local testing use sandbox.
RETAIL_PAYMENT_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Sandbox must use this exact endpoint. Live is allowed only with
# RETAIL_PAYMENT_MODE="live" and VERCEL_ENV="production".
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
# In Vercel, this must match VERCEL_ENV: "preview" or "production". It prevents
# a preview deployment from intentionally sharing the production retail database.
RETAIL_DATABASE_ENVIRONMENT=""
RETAIL_DATABASE_IDENTITY=""
# Set by Vercel Marketplace Neon (managed Postgres).
DATABASE_URL=""
# Optional retail-only override. Use this in Preview so marketplace defaults
# cannot silently point retail traffic at the production/main database.
RETAIL_DATABASE_URL=""
ADMIN_RETAIL_PASSWORD=""
ADMIN_RETAIL_SESSION_SECRET=""
# Retail uses its own public Blob store. Do not use the outreach
# BLOB_READ_WRITE_TOKEN here: it belongs to a separate private store.
RETAIL_BLOB_READ_WRITE_TOKEN=""
RETAIL_BLOB_STORE_ID=""
# Exact public Blob hostname used by next/image and delete-origin validation.
RETAIL_BLOB_HOSTNAME=""
# The authenticated external scheduler sends this as a Bearer credential.
CRON_SECRET=""
# Optional transactional order email delivery through Resend. Keep server-only.
RETAIL_RESEND_API_KEY=""
RETAIL_EMAIL_FROM="TranquilBeads Orders <orders@your-domain.example>"
